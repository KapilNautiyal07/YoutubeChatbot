# --- Database ---------------------------------------------------------------
# PostgreSQL with the pgvector extension installed.
DATABASE_URL=

# --- Provider API keys (server-side only; never exposed to the browser) -----
GROQ_API_KEY= 
GEMINI_API_KEY=

# --- Chat models ------------------------------------------------------------
# Default provider when the UI doesn't specify one: groq | gemini
LLM_PROVIDER=groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_CHAT_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=90

# --- Embeddings (kept separate from chat so indexes stay compatible) ---------
# gemini | local   (local requires: pip install -r requirements-local.txt)
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=50

# --- Chunking (characters) --------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval --------------------------------------------------------------
TOP_K=6
SIMILARITY_THRESHOLD=0.3
RERANK_ENABLED=true
CANDIDATE_POOL_SIZE=20
NEIGHBOR_WINDOW=1
# Max transcript characters sent to the model per answer. Lower this if you hit
# Groq tokens-per-minute limits on the free tier.
MAX_CONTEXT_CHARS=24000
HISTORY_MESSAGES=8

# --- Transcripts ------------------------------------------------------------
PREFERRED_LANGUAGES=["en","en-US","en-GB"]
MAX_TRANSCRIPT_CHARS=1500000

# --- Server -----------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_PROCESS_PER_MINUTE=5
LOG_LEVEL=INFO
